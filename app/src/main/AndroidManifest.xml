<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".PaylisherTestApplication"
        android:allowBackup="true"
        android:label="PaylisherTest"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            FAZ 1 — "Banka senaryosu" reprodüksiyonu.
            Bu service, Paylisher SDK'nın AAR'ında tanımlı olan
            com.paylisher.android.notification.FcmMessagingService'i
            Manifest Merger'da override eder (app manifest > library manifest).
            Sonuç: FCM mesajları SDK'ya değil, BankFcmService'e düşer.
        -->
        <service
            android:name=".BankFcmService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

    </application>
</manifest>
