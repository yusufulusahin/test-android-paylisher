<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
          xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".PaylisherTestApplication"
        android:allowBackup="false"
        tools:replace="android:allowBackup"
        android:label="@string/app_name"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Custom scheme deeplink: paylishertest://... -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="paylishertest" />
            </intent-filter>

            <!-- App Link (autoVerify): https://link.paylisher.com/...
                 Route'lar iOS AASA ile AYNI tutuluyor: /home, /products, /wallet, /profile.
                 (assetlinks.json sadece paketi YETKİLENDİRİR; hangi path'in açılacağını bu
                 intent-filter belirler.) Gerçek otomatik açılış için assetlinks.json yayınlanmalı. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="link.paylisher.com" android:pathPrefix="/home" />
                <data android:scheme="https" android:host="link.paylisher.com" android:pathPrefix="/products" />
                <data android:scheme="https" android:host="link.paylisher.com" android:pathPrefix="/campaigns" />
                <data android:scheme="https" android:host="link.paylisher.com" android:pathPrefix="/wallet" />
                <data android:scheme="https" android:host="link.paylisher.com" android:pathPrefix="/profile" />
            </intent-filter>

            <!-- EU backend domain'i AYRI intent-filter'da: minSdk 24'te tek filtrede çoklu host
                 olunca biri doğrulanamazsa hepsi düşer; ayrı tutunca link.paylisher.com bağımsız doğrulanır.
                 link-eu.paylisher.com/.well-known/assetlinks.json bizim paketi içermeli (yoksa doğrulanmaz). -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="link-eu.paylisher.com" android:pathPrefix="/home" />
                <data android:scheme="https" android:host="link-eu.paylisher.com" android:pathPrefix="/products" />
                <data android:scheme="https" android:host="link-eu.paylisher.com" android:pathPrefix="/campaigns" />
                <data android:scheme="https" android:host="link-eu.paylisher.com" android:pathPrefix="/wallet" />
                <data android:scheme="https" android:host="link-eu.paylisher.com" android:pathPrefix="/profile" />
            </intent-filter>
        </activity>

        <!--
            FAZ 1 — "Banka senaryosu" reprodüksiyonu.
            Bu service, Paylisher SDK'nın AAR'ında tanımlı olan
            com.paylisher.android.notification.FcmMessagingService'i
            Manifest Merger'da override eder (app manifest > library manifest).
            Sonuç: FCM mesajları SDK'ya değil, BankFcmService'e düşer.
        -->
        <service
            android:name=".BankFcmService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

    </application>
</manifest>
